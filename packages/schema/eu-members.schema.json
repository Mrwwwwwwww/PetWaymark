{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "verified_rule_count": {
      "const": 0
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "pending_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source_ids",
        "evidence",
        "pending_checks"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member": {
            "enum": [
              "AT",
              "BE",
              "BG",
              "CY",
              "CZ",
              "DE",
              "DK",
              "EE",
              "ES",
              "FI",
              "FR",
              "GR",
              "HR",
              "HU",
              "IE",
              "IT",
              "LT",
              "LU",
              "LV",
              "MT",
              "NL",
              "PL",
              "PT",
              "RO",
              "SE",
              "SI",
              "SK"
            ]
          },
          "status": {
            "enum": [
              "partial_read_pending_review",
              "local_overlay_uncovered"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "pending_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "member",
          "status",
          "source_ids",
          "evidence",
          "rule_ids",
          "pending_checks"
        ]
      },
      "minItems": 27,
      "uniqueItems": true,
      "maxItems": 27
    },
    "document_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "source_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "intra_eu",
              "third_country_entry"
            ]
          },
          "issued_before": {
            "$ref": "common.schema.json#/$defs/nullableDate"
          },
          "recognition_until": {
            "$ref": "common.schema.json#/$defs/nullableDate"
          }
        },
        "required": [
          "id",
          "source_id",
          "locator",
          "scope",
          "issued_before",
          "recognition_until"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "pending_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "source_ids",
          "summary",
          "pending_checks"
        ]
      },
      "minItems": 2,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "verified_rule_count",
    "framework",
    "members",
    "document_models",
    "exceptions"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petwaymark.org/schemas/0.1.0/eu-members.schema.json"
}
